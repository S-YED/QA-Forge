{
  "name": "qaforge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "ws@<8.21.0": ">=8.21.0",
      "tmp@<0.2.6": ">=0.2.6",
      "qs@<6.15.2": ">=6.15.2",
      "path-to-regexp@<1": "0.1.13",
      "postcss@^8": "^8.5.32",
      "engine.io@^6": "^6.6.11",
      "socket.io-parser@^4": "^4.2.7",
      "proxy-addr@^2": "^2.0.8",
      "body-parser@^1": "^1.20.9",
      "nanoid@^3": "^3.3.20",
      "source-map-js@^1": "^1.2.2",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "sharp@^0.34": "^0.35.5"
    }
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "check-setup": "node scripts/doctor.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "playwright test -c e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "supabase": "^2.84.4",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
