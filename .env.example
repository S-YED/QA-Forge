# Supabase
NEXT_PUBLIC_SUPABASE_URL=           # Your Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=          # Supabase service role key (backend only)

# API
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Database
DATABASE_URL=                        # PostgreSQL connection string

# Security
ENCRYPTION_KEY=                      # 32-byte AES-256 key
JWT_SECRET=                          # JWT signing secret

# Server
PORT=4000
NODE_ENV=development

# AI (optional)
# Provider API keys are added per-user (AES-256-GCM encrypted) via Settings → API Keys.
# Supported providers: OpenAI, Anthropic, Gemini, OpenRouter.
# OPENROUTER_MODEL overrides the OpenRouter model used for generation.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
