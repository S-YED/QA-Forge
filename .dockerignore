# Allowlist: the API image needs only the API, the shared packages and the workspace manifests.
# Everything else (web app, local env files, key dumps, docs) never enters the build context.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!tsconfig.json
!apps/*/package.json
!apps/api
!packages

**/node_modules
**/dist
**/.turbo
**/.impeccable
**/.env*
**/__tests__
**/*.test.ts
packages/*/test
