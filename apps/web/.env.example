# QA Forge web app settings. Copy to apps/web/.env.local.
# Every variable is described in docs/ENVIRONMENT.md.

# Supabase. For local development run `npx supabase status` and copy the Project URL and the
# Publishable (anon) key. Never put the secret (service_role) key here: this file reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# The QA Forge API, used for REST and live run updates (socket.io).
NEXT_PUBLIC_API_URL=http://localhost:4000
