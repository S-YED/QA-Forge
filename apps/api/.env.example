# QA Forge API settings. Copy to apps/api/.env and fill in the two Supabase keys and ENCRYPTION_KEY.
# Every variable is described in docs/ENVIRONMENT.md. Startup fails with a clear message if one is wrong.

PORT=4000
NODE_ENV=development
# Web origins allowed to call the API (comma-separated). Match the port the web app runs on.
CORS_ORIGIN=http://localhost:3000

# Supabase. For local development run `npx supabase status` and copy:
#   API URL -> SUPABASE_URL, Publishable (anon) key -> SUPABASE_ANON_KEY, Secret (service_role) key -> SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-publishable-key
# Secret: bypasses row-level security. Backend only, never in the web app or in git.
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-key

# Encrypts users' stored AI keys: 64 hex characters. Generate once and keep it (changing it makes
# stored keys unreadable):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional: shared run-concurrency counter and socket.io adapter. Without it the API runs single-instance.
# REDIS_URL=redis://localhost:6379

# SSRF guard: hostnames test runs may reach although they resolve to private or loopback addresses.
# `*` allows all, for local development (the demo shop on 127.0.0.1). Leave empty in production.
ALLOW_PRIVATE_HOSTS=*

# Local demo mode: users with no AI key get fixed example tests for the demo shop (apps/demo-app).
# They are not AI and the UI says so. Turn off in production.
AI_LOCAL_DEMO=true

# Optional AI settings. Provider API keys are not env vars: each user adds theirs in Settings, API Keys.
# AI_TIMEOUT_MS=60000
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# GEMINI_MODEL=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
